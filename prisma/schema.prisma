generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      session[]
  accounts      account[]

  // better-auth admin plugin fields. `role` holds one of src/lib/roles.ts ROLES.
  role       String?   @db.VarChar(32)
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  /// The partner workshop this person works FOR, when they are not ours.
  ///
  /// Only a `taller` role may carry one — `user_taller_solo_rol_taller_check` enforces it in the
  /// database, because this is what decides how much of a job somebody outside the company sees.
  /// Null means one of ours: a mechanic on Estación 360's own floor.
  tallerId String?
  taller   taller? @relation("tallerMecanicos", fields: [tallerId], references: [id], onDelete: SetNull)

  invitationsSent invitation[] @relation("invitedBy")
  auditLogs       audit_log[]  @relation("auditActor")
  citasAsignadas  cita[]       @relation("citaAsignada")

  notasRecibidas    nota_servicio[]      @relation("notaRecibidaPor")
  evidenciasSubidas nota_evidencia[]     @relation("evidenciaSubidaPor")
  comentarios       nota_comentario[]    @relation("comentarioAutor")
  transferencias    nota_transferencia[] @relation("transferenciaEnviadaPor")
  qaTransferencias  nota_transferencia[] @relation("transferenciaQaPor")
  lecturasKm        unidad_kilometraje[] @relation("kilometrajeRegistradoPor")
  cotizaciones      cotizacion[]         @relation("cotizacionCreadaPor")
  facturas          factura[]            @relation("facturaCreadaPor")
  pagos             pago[]               @relation("pagoRegistradoPor")

  notificaciones      notificacion[]             @relation("notificacionDestinatario")
  suscripcionesPush   push_suscripcion[]         @relation("pushSuscripcion")
  preferenciasAviso   notificacion_preferencia[] @relation("notificacionPreferencia")
  talleresRevisados   taller[]                   @relation("tallerRevisadoPor")

  notasAsignadas       nota_servicio[]         @relation("notaMecanico")
  entradasRegistradas  inventario_entrada[]    @relation("entradaRegistradaPor")
  movimientosRegistrados inventario_movimiento[] @relation("movimientoRegistradoPor")
  refaccionesSolicitadas solicitud_refaccion[]  @relation("refaccionSolicitadaPor")
  refaccionesResueltas   solicitud_refaccion[]  @relation("refaccionResueltaPor")

  @@map("user")
}

/// Append-only audit trail for every state-changing operation in the system.
/// NEVER update or delete a row here — see CLAUDE.md Rule 3.
///
/// Actor identity is stored twice on purpose: `actorId` for joins, `actorEmail` as a
/// snapshot so the record still says who did it after that account is removed. Same for
/// `entityLabel`, which survives the audited row being deleted.
model audit_log {
  id          String   @id
  /// `<entity>.<action>`, from AUDIT_ACTIONS in src/lib/audit-actions.ts.
  action      String   @db.VarChar(64)
  entity      String   @db.VarChar(64)
  entityId    String?
  entityLabel String?  @db.VarChar(255)
  actorId     String?
  actor       user?    @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String   @db.VarChar(255)
  summary     String?  @db.VarChar(500)
  /// State before and after, for diffing. Never put secrets or password hashes in here.
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // better-auth admin plugin field (impersonation).
  impersonatedBy String?

  @@map("session")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Invitation-only onboarding. There is no public sign-up: a user account can only
/// come into existence by accepting one of these. See src/lib/server/invitations.ts.
model invitation {
  id          String    @id
  email       String
  role        String    @db.VarChar(32)
  /// SHA-256 of the invite token. The raw token is returned once, at creation, and
  /// never stored — a leaked DB row cannot be replayed into an account.
  tokenHash   String    @unique
  invitedById String
  invitedBy   user      @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invitation")
}

/// A customer: either a person or an organization. `tipo` decides which name fields apply;
/// a CHECK constraint in the migration enforces it rather than trusting the app layer.
///
/// A **persona** customer is implicitly authorized to collect their own units — they do not
/// need a `cliente_contacto` row. An **organizacion** cannot sign for anything, so it needs
/// named people.
model cliente {
  id   String @id
  tipo String @db.VarChar(16)

  /// persona
  nombre    String? @db.VarChar(120)
  apellidos String? @db.VarChar(120)
  /// organizacion
  razonSocial String? @db.VarChar(200)

  /// Denormalized display name, rewritten on every create/update. One indexed column that
  /// searches and sorts both customer types — without it every list query needs a COALESCE
  /// across three columns.
  nombreCompleto String @db.VarChar(255)

  telefono  String? @db.VarChar(32)
  email     String? @db.VarChar(255)
  direccion String? @db.VarChar(500)
  notas     String?

  /// CFDI 4.0. All optional until invoicing exists.
  rfc           String? @db.VarChar(13)
  regimenFiscal String? @db.VarChar(8)
  codigoPostal  String? @db.VarChar(5)
  usoCfdi       String? @db.VarChar(8)

  /// Credit terms. `limiteCredito` null means no credit at all — the customer pays on delivery.
  /// Money is Decimal, never Float: a peso that drifts by a cent is a peso somebody argues about.
  limiteCredito Decimal? @db.Decimal(12, 2)
  diasCredito   Int?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contactos   cliente_contacto[]
  unidades    unidad[]
  propiedades unidad_propietario[]
  citas       cita[]
  /// Not `notas` — that name is already the free-text field above.
  notasServicio nota_servicio[]
  facturas      factura[]

  notificaciones    notificacion[]     @relation("notificacionCliente")
  suscripcionesPush push_suscripcion[] @relation("pushSuscripcionCliente")

  @@index([nombreCompleto])
  @@index([rfc])
  @@index([archivedAt])
  @@map("cliente")
}

/// A person attached to one customer. Scoped, not shared: the same human on two customers
/// is two rows. `roles` holds keys from CONTACTO_ROLES in src/lib/contacto-roles.ts.
model cliente_contacto {
  id        String  @id
  clienteId String
  cliente   cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nombre   String  @db.VarChar(200)
  telefono String? @db.VarChar(32)
  email    String? @db.VarChar(255)
  /// Free-text ID note for counter verification, e.g. "INE 1234". Never document images.
  identificacion String? @db.VarChar(120)
  notas          String?

  roles String[] @db.VarChar(32)

  /// "todas" | "especificas". Explicit on purpose: encoding "no rows in contacto_unidad
  /// means all units" is shorter but reads as a bug later.
  alcanceUnidades String @default("todas") @db.VarChar(16)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  unidadesAutorizadas contacto_unidad[]
  citasComoEntregador cita[]
  notasEntregadas     nota_servicio[] @relation("notaEntregadaA")
  notasEntregadasPorEl nota_servicio[] @relation("notaEntregoUnidad")
  cotizacionesAutorizadas cotizacion[] @relation("cotizacionAutorizadaPor")

  @@index([clienteId])
  @@index([archivedAt])
  @@map("cliente_contacto")
}

/// Which units a contact may collect. Only consulted when alcanceUnidades = "especificas".
model contacto_unidad {
  contactoId String
  contacto   cliente_contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  unidadId   String
  unidad     unidad           @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@id([contactoId, unidadId])
  @@index([unidadId])
  @@map("contacto_unidad")
}

/// A vehicle. Only marca and modelo are required so a car can be received at the counter in
/// seconds and completed later.
///
/// `clienteId` is the CURRENT owner and deliberately duplicates the open unidad_propietario
/// row (the one with `hasta` null). Deriving the owner from history alone would put a join on
/// every unit query. Both are written in the SAME transaction — see transferUnidad.
model unidad {
  id        String  @id
  clienteId String
  cliente   cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  marca  String  @db.VarChar(60)
  modelo String  @db.VarChar(60)
  anio   Int?
  color  String? @db.VarChar(40)
  /// Not unique: plates get reassigned between vehicles over time.
  placas String? @db.VarChar(16)
  /// VIN/NIV — the real identity when present. Older units may not have one.
  vin    String? @unique @db.VarChar(24)
  /// The number a fleet paints on the door, and how they actually refer to a truck.
  numeroEconomico String? @db.VarChar(32)
  kilometraje     Int?
  notas           String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  propietarios unidad_propietario[]
  autorizados  contacto_unidad[]
  citas        cita[]
  notasServicio nota_servicio[]
  lecturasKm    unidad_kilometraje[]

  @@index([clienteId])
  @@index([placas])
  @@index([numeroEconomico])
  @@index([archivedAt])
  @@map("unidad")
}

/// Ownership history. The current owner is the row with `hasta` null.
/// Visible to anyone with cliente:read — not just Admins reading the audit trail.
model unidad_propietario {
  id        String  @id
  unidadId  String
  unidad    unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  desde  DateTime  @default(now())
  hasta  DateTime?
  motivo String?   @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([unidadId])
  @@index([clienteId])
  @@map("unidad_propietario")
}

/// An appointment. Two origins, one table.
///
/// `origen = 'publico'` rows come from the anonymous form behind Cloudflare Turnstile and land
/// as `estado = 'solicitada'` with a `fecha` + `franja` but no exact hour. Staff grant the hour
/// when they confirm. `origen = 'panel'` rows are booked at the counter and always have `inicio`.
///
/// The contact and vehicle strings are kept as SUBMITTED, permanently, even after `clienteId` /
/// `unidadId` are linked: an anonymous visitor cannot be trusted to identify a customer, and the
/// record should always show what was actually said. Same reasoning as audit_log.entityLabel.
model cita {
  id String @id
  /// Said out loud on the phone: "su cita es la 1042".
  folio Int @unique @default(autoincrement())

  /// 'publico' | 'panel'
  origen String @db.VarChar(16)
  /// solicitada | confirmada | en_proceso | completada | cancelada | no_asistio
  estado String @default("solicitada") @db.VarChar(16)
  /// 'en_sitio' | 'recoleccion' — whether we go get the vehicle.
  tipo String @db.VarChar(16)

  /// The day, always known. `franja` is what the customer asked for; `inicio`/`fin` is what the
  /// shop granted, and is null until somebody schedules it.
  fecha  DateTime  @db.Date
  franja String?   @db.VarChar(8)
  inicio DateTime? @db.Timestamptz(6)
  fin    DateTime? @db.Timestamptz(6)

  nombre   String  @db.VarChar(120)
  telefono String  @db.VarChar(32)
  email    String? @db.VarChar(255)
  marca    String? @db.VarChar(60)
  modelo   String? @db.VarChar(60)
  anio     Int?
  placas   String? @db.VarChar(16)
  /// What the customer says they need.
  motivo String
  /// Internal, never shown to the customer and never writable from the public form.
  notas String?

  /// Filled in when staff recognise the customer. Nullable because a public request exists
  /// before any of this is known — but CONFIRMING one requires both, enforced in confirmarCita.
  /// SetNull so archiving history never deletes an appointment.
  clienteId String?
  cliente   cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  unidadId  String?
  unidad    unidad?  @relation(fields: [unidadId], references: [id], onDelete: SetNull)

  /// Who will hand the unit over, when it is not the customer themselves. Must be a contact of
  /// `clienteId` holding the `entregador` role — checked in the server module, since a FK cannot
  /// express "belongs to the same customer".
  entregadorId String?
  entregador   cliente_contacto? @relation(fields: [entregadorId], references: [id], onDelete: SetNull)

  /// Required when tipo = 'recoleccion' (CHECK constraint) — sending someone to collect a
  /// vehicle without an address is not a real appointment.
  direccionRecoleccion String? @db.VarChar(500)

  /// Who is handling the pickup. An Operador may advance only the appointments pointing here.
  asignadoId String?
  asignado   user?   @relation("citaAsignada", fields: [asignadoId], references: [id], onDelete: SetNull)

  canceladoMotivo String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([inicio])
  @@index([estado])
  @@index([asignadoId])
  @@index([clienteId])
  @@index([telefono])
  /// The calendar's hot query: everything in this week, in order. Declared here as well as in
  /// the citas migration so Prisma stops proposing to drop it on every future diff.
  /// The service note opened when the vehicle actually arrived. At most one per appointment.
  nota nota_servicio?

  @@index([fecha, inicio])
  /// Declared here, not only in SQL: an index that exists in the database but not in the schema
  /// is one Prisma proposes to DROP on the next diff — which is exactly how this one was lost
  /// once already. Same reason as [fecha, inicio] above.
  @@index([entregadorId])
  @@map("cita")
}

/// A partner workshop. Estación 360 receives the vehicle and sources the job out to one of these.
///
/// External only, by decision: internal work needs no transfer. These will eventually be
/// onboarded as users of the `taller` role — that link does not exist yet, deliberately.
model taller {
  id       String  @id
  nombre   String  @db.VarChar(160)
  telefono String? @db.VarChar(32)
  email    String? @db.VarChar(255)
  contacto String? @db.VarChar(120)
  direccion String? @db.VarChar(500)
  /// Free text for now: "hojalatería, pintura, transmisiones".
  especialidades String? @db.VarChar(500)
  notas          String?

  /// Where the row came from: `panel` (staff added it) or `publico` (they applied at /talleres).
  origen String @default("panel") @db.VarChar(16)

  /// solicitado | aprobado | rechazado.
  ///
  /// Certification, as a status on the one registry rather than a separate applications table —
  /// approving is then a status change, not a copy between tables that can disagree.
  /// **Only `aprobado` may receive a vehicle**; `transferirNota` enforces it.
  estado String @default("aprobado") @db.VarChar(16)

  /// What they told us when they applied. Kept verbatim even after approval, same reasoning as
  /// the free-text fields on `cita`: the record shows what was actually claimed.
  rfc          String? @db.VarChar(13)
  ciudad       String? @db.VarChar(80)
  sitioWeb     String? @db.VarChar(255)
  anosOperando Int?
  empleados    Int?

  revisadoPorId  String?
  revisadoPor    user?     @relation("tallerRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoAt     DateTime?
  /// Mandatory on a rejection — enforced by `taller_rechazo_motivo_check`. It is what gets read
  /// back to the shop, so "no" is never just silence.
  revisionMotivo String?   @db.VarChar(500)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Their own people, with accounts. Only `taller`-role users; see `user.tallerId`.
  mecanicos       user[]          @relation("tallerMecanicos")
  notas_recibidas nota_servicio[]
  transferencias  nota_transferencia[]
  sucursales      taller_sucursal[]

  @@index([nombre])
  @@index([archivedAt])
  @@index([estado])
  @@map("taller")
}

/// The service note: what exists once the vehicle is physically at the shop.
///
/// Opened from a cita on arrival ("Recibir unidad") or standalone for a walk-in. Carries the
/// intake inspection, the evidence, the comments, and everything commercial that follows.
///
/// `clienteId` is stored AT INTAKE and never follows a later ownership transfer — the vehicle
/// keeps one continuous service history, but each job stays billed to whoever owned it that day.
model nota_servicio {
  id    String @id
  folio Int    @unique @default(autoincrement())

  /// Where it came from. SetNull so deleting a request never erases the work that followed.
  citaId String?       @unique
  cita   cita?         @relation(fields: [citaId], references: [id], onDelete: SetNull)
  clienteId String
  cliente   cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  unidadId  String
  unidad    unidad     @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  /// recibida | en_diagnostico | en_taller | lista | entregada | cancelada
  estado String @default("recibida") @db.VarChar(20)

  /// Who took the vehicle in. Kept even if that account is later removed.
  recibidaPorId String?
  recibidaPor   user?    @relation("notaRecibidaPor", fields: [recibidaPorId], references: [id], onDelete: SetNull)
  recibidaAt    DateTime @default(now())

  /// Intake inspection. Nullable because the note is created the moment the vehicle arrives and
  /// the walk-around takes a few minutes; `inspeccionAt` is what says it was actually done.
  kilometraje        Int?
  combustibleOctavos Int?
  /// Damage and condition as found, in the operator's words.
  condicion    String?
  inspeccionAt DateTime?

  motivo       String
  diagnostico  String?
  observaciones String?

  /// The partner shop currently holding the vehicle. Denormalized from the open row in
  /// nota_transferencia, exactly like unidad.clienteId — both are written in one transaction.
  tallerActualId String?
  tallerActual   taller? @relation(fields: [tallerActualId], references: [id], onDelete: SetNull)

  /// One open note per vehicle is enforced by `nota_servicio_unidad_abierta_key`, a partial unique
  /// index Prisma cannot express. Declared in the migration; do not "simplify" it into app code —
  /// the app check reads before it writes and loses a race a double-tapped button creates daily.

  /// Who physically HANDED THE VEHICLE OVER at intake.
  ///
  /// Free text plus an optional FK, the same shape as `cita`: whoever showed up is often the
  /// owner's brother-in-law, a driver, a neighbour — a real person the shop needs on the record
  /// and who will never be a `cliente_contacto`. Requiring registration here would mean either
  /// refusing the vehicle or inventing a contact row that nobody maintains.
  ///
  /// The name is snapshotted even when the contact IS registered, so the record still reads after
  /// that contact is archived — same reasoning as `audit_log.entityLabel`.
  entregoNombre    String? @db.VarChar(120)
  entregoTelefono  String? @db.VarChar(32)
  entregoContactoId String?
  entregoContacto   cliente_contacto? @relation("notaEntregoUnidad", fields: [entregoContactoId], references: [id], onDelete: SetNull)

  entregadaAt DateTime?
  /// Who physically collected the unit. Must be the customer or one of its `entregador` contacts.
  entregadaAContactoId String?
  entregadaAContacto   cliente_contacto? @relation("notaEntregadaA", fields: [entregadaAContactoId], references: [id], onDelete: SetNull)

  canceladoMotivo String? @db.VarChar(255)

  /// Opaque follow-along token, 256 bits, base64url. Handed to the customer by WhatsApp as
  /// /seguimiento/<token>.
  ///
  /// This is how somebody with no account reads their vehicle's status and turns on push — the
  /// app has no public registration, so there is no session to hang a customer subscription off.
  /// Nullable so it can be revoked without losing the note, and unguessable so it is its own gate.
  seguimientoToken String? @unique @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventario     nota_inventario[]
  evidencias     nota_evidencia[]
  comentarios    nota_comentario[]
  transferencias nota_transferencia[]
  cotizaciones   cotizacion[]
  facturas       factura[]
  lecturas       unidad_kilometraje[]

  /// The mechanic working on it. This is the ONLY thing the `taller` role can see: their own
  /// assigned notes. Without it that role has no screen at all.
  mecanicoId String?
  mecanico   user?   @relation("notaMecanico", fields: [mecanicoId], references: [id], onDelete: SetNull)
  /// The mechanic says "I'm done"; advancing the note itself stays with the counter. Two different
  /// facts — the work being finished and the job being ready to hand over — and conflating them is
  /// how a car gets promised to a customer before anybody checked it.
  trabajoTerminadoAt DateTime?

  movimientos inventario_movimiento[]
  solicitudes solicitud_refaccion[]

  @@index([estado])
  @@index([clienteId])
  @@index([unidadId])
  @@index([tallerActualId])
  @@index([recibidaAt])
  @@index([mecanicoId])
  @@map("nota_servicio")
}

/// What was in the vehicle when it came in. A fixed catalogue (INVENTARIO_ITEMS) so the same
/// things get checked every time — a missing jack is noticed on delivery, not argued about.
model nota_inventario {
  notaId String
  nota   nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)
  /// Key from INVENTARIO_ITEMS in src/lib/notas.ts.
  item     String  @db.VarChar(40)
  presente Boolean
  notas    String? @db.VarChar(255)

  @@id([notaId, item])
  @@map("nota_inventario")
}

/// Photos and documents backing the note, stored in Cloudflare R2.
///
/// The row holds the object KEY, never a signed URL: signatures expire, and a stored one would
/// rot into a broken image. The public URL is derived at read time.
model nota_evidencia {
  id     String        @id
  notaId String
  nota   nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)

  /// foto | documento
  tipo String @db.VarChar(16)
  /// Key from FOTO_CATEGORIAS, e.g. `frente`, `tablero`, `dano`.
  categoria   String  @db.VarChar(32)
  /// R2 object key. Generated server-side — never taken from the client.
  clave       String  @unique @db.VarChar(500)
  nombre      String  @db.VarChar(255)
  contentType String  @db.VarChar(120)
  bytes       Int?
  descripcion String? @db.VarChar(500)

  subidaPorId String?
  subidaPor   user?    @relation("evidenciaSubidaPor", fields: [subidaPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([notaId])
  @@index([categoria])
  @@map("nota_evidencia")
}

/// Running commentary on the job. `interno` never leaves the shop; the rest is what gets read
/// back to the customer, so the distinction is stored rather than remembered.
model nota_comentario {
  id     String        @id
  notaId String
  nota   nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)

  texto   String
  interno Boolean @default(true)

  autorId String?
  autor   user?    @relation("comentarioAutor", fields: [autorId], references: [id], onDelete: SetNull)
  /// Snapshot, so the trail still reads correctly after the account is gone.
  autorEmail String   @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([notaId, createdAt])
  @@map("nota_comentario")
}

/// History of the vehicle going out to partner shops and coming back. The open row (`hasta` null)
/// is the current holder and must match nota_servicio.tallerActualId.
model nota_transferencia {
  id       String        @id
  notaId   String
  nota     nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tallerId String
  taller   taller        @relation(fields: [tallerId], references: [id], onDelete: Restrict)

  motivo   String   @db.VarChar(500)
  desde    DateTime @default(now())
  hasta    DateTime?
  /// What the partner shop reported back when the unit returned.
  resultado String?

  /// QA on receipt. Nothing comes back from an external shop without somebody signing off:
  /// Estación 360 is who the customer holds responsible for the repair, so accepting the work
  /// back is a decision with a name on it. `aprobado | con_detalles | rechazado`.
  qaResultado String?   @db.VarChar(16)
  qaNotas     String?
  qaAt        DateTime?
  qaPorId     String?
  qaPor       user?     @relation("transferenciaQaPor", fields: [qaPorId], references: [id], onDelete: SetNull)

  enviadaPorId String?
  enviadaPor   user?   @relation("transferenciaEnviadaPor", fields: [enviadaPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([notaId])
  @@index([tallerId])
  /// Created by the QA migration, so it is declared here with its original name — an index the
  /// database has and the schema does not is drift, and the next `migrate diff` drops it.
  @@index([qaResultado], map: "nota_transferencia_qa_idx")
  @@map("nota_transferencia")
}

/// Odometer readings over time.
///
/// Every intake writes one, which is what makes "how much has this truck run between visits" and
/// "how often does it come in" answerable from the same table. `unidad.kilometraje` is the latest
/// reading, denormalized so the unit list does not need a subquery — both written together.
model unidad_kilometraje {
  id       String @id
  unidadId String
  unidad   unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  kilometraje Int
  /// nota | alta | manual — see ORIGENES_KILOMETRAJE.
  origen   String   @db.VarChar(16)
  medidoAt DateTime @default(now())

  notaId String?
  nota   nota_servicio? @relation(fields: [notaId], references: [id], onDelete: SetNull)

  registradoPorId String?
  registradoPor   user?   @relation("kilometrajeRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  /// Set when somebody knowingly recorded a reading below the previous one.
  correccion Boolean @default(false)
  notas      String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([unidadId, medidoAt])
  @@index([notaId])
  /// The reporting query: "what has this unit run between visits", newest first. Declared here
  /// as well as in SQL so Prisma stops proposing to drop it — see the note on cita.entregadorId.
  @@index([unidadId, medidoAt(sort: Desc), kilometraje], map: "unidad_kilometraje_reporte_idx")
  @@map("unidad_kilometraje")
}

/// A quote for the work. Editable only while `borrador`: once the customer has seen it, changing
/// the numbers underneath them is exactly what the estado machine prevents.
model cotizacion {
  id     String        @id
  folio  Int           @unique @default(autoincrement())
  notaId String
  nota   nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)

  /// What the CUSTOMER has said: borrador | enviada | autorizada | rechazada | vencida.
  estado String @default("borrador") @db.VarChar(16)

  /// What the SHOP is doing about it: pendiente | en_proceso | completada | por_cobrar | cobrada.
  ///
  /// Two axes on purpose. "The customer approved it" and "we finished and got paid" are different
  /// questions with different owners, and squeezing both into one column means every new answer to
  /// one of them multiplies the states of the other.
  ///
  /// It only leaves `pendiente` once the customer has authorized — enforced in `avanzarInterno` —
  /// and `cobrada` is reached by ARITHMETIC over the payments, never by a button.
  estadoInterno String @default("pendiente") @db.VarChar(16)

  /// Totals in pesos. Recomputed from the line items on every write — never trusted from input.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  iva      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  vigenciaHasta DateTime?
  notas         String?

  enviadaAt DateTime?
  /// WHO on the customer's side approved it — a contact holding `autorizador`, or null when the
  /// customer is a persona approving their own work.
  autorizadaPorContactoId String?
  autorizadaPorContacto   cliente_contacto? @relation("cotizacionAutorizadaPor", fields: [autorizadaPorContactoId], references: [id], onDelete: SetNull)
  /// How the approval arrived: teléfono, WhatsApp, en persona.
  autorizadaMedio String?   @db.VarChar(60)
  autorizadaAt    DateTime?
  rechazadaMotivo String?   @db.VarChar(500)

  creadaPorId String?
  creadaPor   user?    @relation("cotizacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conceptos cotizacion_concepto[]
  facturas  factura[]

  @@index([notaId])
  @@index([estado])
  @@map("cotizacion")
}

model cotizacion_concepto {
  id           String     @id
  cotizacionId String
  cotizacion   cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  /// refaccion | mano_obra | insumo | externo
  tipo        String  @db.VarChar(16)
  descripcion String  @db.VarChar(500)
  /// Fractional on purpose: 1.5 hours of labour is a real line.
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(12, 2)
  importe        Decimal @db.Decimal(12, 2)
  orden          Int     @default(0)

  /// Optional link to the catalogue. Optional because a one-off line ("mandar rectificar la
  /// cabeza con el torno de la esquina") is a real quote line that will never be a product.
  productoId String?
  producto   producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  /// SAT keys COPIED from the product at the moment the line was written, never read through the
  /// relation. Re-classifying a product later must not silently rewrite what was already quoted —
  /// same reasoning as copying the credit terms onto an invoice at issue.
  claveProdServ String? @db.VarChar(8)
  claveUnidad   String? @db.VarChar(3)

  /// Stock actually issued against this line, in product units. Reaching `cantidad` is what
  /// "surtido" means; it is a SUM of movements, never a checkbox.
  surtido Decimal @default(0) @db.Decimal(12, 3)

  movimientos inventario_movimiento[]

  @@index([cotizacionId, orden])
  @@index([productoId])
  @@map("cotizacion_concepto")
}

/// An invoice. `credito` is the only condition that consumes the customer's limit, and the due
/// date is derived from their `diasCredito` at the moment it is issued.
model factura {
  id     String  @id
  folio  Int     @unique @default(autoincrement())
  notaId String?
  nota   nota_servicio? @relation(fields: [notaId], references: [id], onDelete: SetNull)
  /// Who it is billed to. Restrict: a customer with invoices is never hard-deleted.
  clienteId String
  cliente   cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  cotizacionId String?
  cotizacion   cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)

  /// borrador | emitida | pagada | cancelada
  estado String @default("borrador") @db.VarChar(16)
  /// contado | credito
  condicionPago String @default("contado") @db.VarChar(16)
  diasCredito   Int?
  vence         DateTime?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  iva      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// CFDI stamping data, filled in once a PAC is wired up.
  uuid         String? @unique @db.VarChar(36)
  serie        String? @db.VarChar(25)
  emitidaAt    DateTime?
  canceladaAt  DateTime?
  canceladoMotivo String? @db.VarChar(255)
  notas        String?

  creadaPorId String?
  creadaPor   user?    @relation("facturaCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pagos pago[]

  @@index([clienteId])
  @@index([estado])
  @@index([vence])
  @@map("factura")
}

/// A payment against an invoice. Partial by design: the invoice is `pagada` when the payments
/// cover it, never by somebody flipping a status by hand.
model pago {
  id        String  @id
  facturaId String
  factura   factura @relation(fields: [facturaId], references: [id], onDelete: Restrict)

  monto  Decimal @db.Decimal(12, 2)
  /// efectivo | tarjeta | transferencia | cheque | otro
  metodo     String  @db.VarChar(16)
  referencia String? @db.VarChar(120)
  notas      String? @db.VarChar(500)

  pagadoAt DateTime @default(now())

  registradoPorId String?
  registradoPor   user?    @relation("pagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([facturaId])
  @@index([pagadoAt])
  @@map("pago")
}

model configurations {
  id         Int      @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  key        String   @db.VarChar(255) @unique
  value      String?  @db.VarChar(255)

  @@id([id, key])
  @@index([key])
  @@map("configurations")
}

// ============================================================================================
// Notificaciones
// ============================================================================================

/// One notification, for one recipient.
///
/// The recipient is EITHER a `user` (staff) or a `cliente` (customer) — never both, never
/// neither. Enforced by `notificacion_destinatario_check`, because a row addressed to nobody is
/// a notification that silently vanishes, and one addressed to both would leak staff-only copy
/// to a customer.
///
/// The row is written even when push delivery fails or is switched off: the in-app inbox is the
/// system of record, push is a courtesy on top of it.
model notificacion {
  id String @id

  userId String?
  user   user?   @relation("notificacionDestinatario", fields: [userId], references: [id], onDelete: Cascade)
  /// Customer-facing copy. NEVER names a partner taller — see notaParaCliente in server/notas.ts.
  clienteId String?
  cliente   cliente? @relation("notificacionCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  /// Key from NOTIFICACION_EVENTOS in src/lib/notificaciones.ts.
  evento String @db.VarChar(48)
  titulo String @db.VarChar(120)
  cuerpo String @db.VarChar(500)
  /// Deep link. Staff links point into /panel; customer links into /seguimiento/<token>.
  url String? @db.VarChar(500)

  /// What it is about, so a screen can show only its own notifications.
  entidad   String? @db.VarChar(32)
  entidadId String?

  leidaAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, leidaAt])
  @@index([clienteId, createdAt])
  @@index([entidad, entidadId])
  @@map("notificacion")
}

/// A Web Push subscription: one browser on one device.
///
/// Same either/or as `notificacion` — a subscription belongs to a staff user or to a customer.
/// Customers subscribe from /seguimiento/<token>, which is how a person with no account gets
/// push at all.
///
/// `fallos` counts consecutive delivery failures. A 404/410 from the push service means the
/// subscription is dead and the row is deleted outright; anything else just increments.
model push_suscripcion {
  id String @id

  userId String?
  user   user?   @relation("pushSuscripcion", fields: [userId], references: [id], onDelete: Cascade)
  clienteId String?
  cliente   cliente? @relation("pushSuscripcionCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  /// The push service URL. Unique: re-subscribing the same browser updates the row instead of
  /// piling up duplicates that would each deliver the same notification.
  endpoint String @unique @db.VarChar(500)
  /// RFC 8291 keys, base64url, exactly as the browser hands them over.
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(64)

  /// What the person will recognise in the device list: "Chrome en Android".
  etiqueta  String? @db.VarChar(80)
  userAgent String? @db.VarChar(255)

  fallos        Int       @default(0)
  ultimoEnvioAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([clienteId])
  @@map("push_suscripcion")
}

/// A staff member's opt-OUT for one event.
///
/// Absent row means "both channels on". Only writing the exceptions means a new user needs no
/// backfill and a new event key needs no migration — the default is always current.
model notificacion_preferencia {
  userId String
  user   user   @relation("notificacionPreferencia", fields: [userId], references: [id], onDelete: Cascade)
  /// Key from NOTIFICACION_EVENTOS.
  evento String @db.VarChar(48)

  enApp Boolean @default(true)
  push  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@id([userId, evento])
  @@map("notificacion_preferencia")
}

// ============================================================================================
// Registro de talleres
// ============================================================================================

/// A branch of a partner workshop, with its own contact person.
///
/// The head office is a sucursal too (`esPrincipal`), so "where is this shop" has exactly one
/// answer shape. A partial unique index allows at most one principal per taller.
model taller_sucursal {
  id       String @id
  tallerId String
  taller   taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  nombre    String  @db.VarChar(160)
  direccion String? @db.VarChar(500)
  ciudad    String? @db.VarChar(80)
  telefono  String? @db.VarChar(32)

  /// The named person at this branch. A phone number without a person to ask for is not a contact.
  contactoNombre   String? @db.VarChar(120)
  contactoPuesto   String? @db.VarChar(80)
  contactoTelefono String? @db.VarChar(32)
  contactoEmail    String? @db.VarChar(255)

  esPrincipal Boolean @default(false)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tallerId])
  @@map("taller_sucursal")
}

// ============================================================================================
// Catálogo e inventario
// ============================================================================================

/// A product or service the shop sells: a part, an hour of labour, a consumable.
///
/// SAT keys are carried from day one even though nothing is stamped yet. Adding them later means
/// going back over every line ever quoted to guess what `ClaveProdServ` it should have had — and
/// nobody remembers. They are cheap now and impossible to backfill honestly.
///
/// `controlaInventario` is what separates a part from an hour of labour: you cannot run out of
/// labour, so it has no stock, no layers and no movements.
model producto {
  id  String  @id
  sku String? @unique @db.VarChar(40)

  nombre      String  @db.VarChar(200)
  descripcion String? @db.VarChar(500)
  /// refaccion | mano_obra | insumo | externo — the same vocabulary as cotizacion_concepto.tipo.
  tipo String @db.VarChar(16)

  /// SAT c_ClaveProdServ (8 digits) and c_ClaveUnidad (up to 3 chars). Claves, never labels —
  /// the same rule as `cliente.regimenFiscal`.
  claveProdServ String @db.VarChar(8)
  claveUnidad   String @db.VarChar(3)
  /// What a human reads: "Pieza", "Hora", "Litro".
  unidad String @db.VarChar(20)

  /// What we charge. Money is Decimal, never Float.
  precioVenta Decimal @default(0) @db.Decimal(12, 2)
  /// IVA rate for this line. Stored per product because not everything is 16%.
  ivaTasa Decimal @default(0.16) @db.Decimal(5, 4)

  controlaInventario Boolean @default(true)
  /// Denormalized sum of the open FIFO layers, so a product list needs no subquery. Written in
  /// the SAME transaction as the layers — exactly like `unidad.kilometraje`.
  existencia Decimal @default(0) @db.Decimal(12, 3)
  /// Reorder point. Null means nobody wants to be told.
  minimo Decimal? @db.Decimal(12, 3)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  capas       inventario_capa[]
  movimientos inventario_movimiento[]
  conceptos   cotizacion_concepto[]
  solicitudes solicitud_refaccion[]

  @@index([nombre])
  @@index([tipo])
  @@index([archivedAt])
  @@map("producto")
}

/// A goods receipt: one delivery from one supplier, optionally backed by its CFDI.
///
/// The XML is stored VERBATIM. A parsed summary is convenient, but the stamped document is the
/// thing the SAT and the supplier both recognise, and re-deriving it from columns is impossible.
model inventario_entrada {
  id    String @id
  folio Int    @unique @default(autoincrement())

  proveedor  String? @db.VarChar(200)
  /// The supplier's own invoice or remission number, for people who do not use CFDI.
  referencia String? @db.VarChar(120)

  /// CFDI 4.0, all optional: plenty of parts arrive with a paper note and nothing else.
  /// `cfdiUuid` is unique so the same invoice cannot be received into stock twice.
  cfdiUuid         String?   @unique @db.VarChar(36)
  cfdiEmisorRfc    String?   @db.VarChar(13)
  cfdiEmisorNombre String?   @db.VarChar(200)
  cfdiTotal        Decimal?  @db.Decimal(12, 2)
  cfdiFecha        DateTime?
  cfdiXml          String?

  notas String?

  registradaPorId String?
  registradaPor   user?    @relation("entradaRegistradaPor", fields: [registradaPorId], references: [id], onDelete: SetNull)
  recibidaAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  capas       inventario_capa[]
  movimientos inventario_movimiento[]

  @@index([recibidaAt])
  @@map("inventario_entrada")
}

/// One FIFO layer: a quantity bought at one cost, consumed oldest-first.
///
/// This is the whole reason inventory is not a single `existencia` number. Ten filters bought at
/// $80 and ten more at $95 are not twenty filters at $87.50 — the cost of the next one out is $80
/// until the first ten are gone, and a margin computed any other way is fiction.
model inventario_capa {
  id         String   @id
  productoId String
  producto   producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  entradaId  String?
  entrada    inventario_entrada? @relation(fields: [entradaId], references: [id], onDelete: SetNull)

  cantidad Decimal @db.Decimal(12, 3)
  /// What is LEFT in this layer. Reaches zero and the layer is spent, never deleted — the
  /// movements that consumed it still point here.
  restante Decimal @db.Decimal(12, 3)
  /// Four decimals: unit cost divides, and rounding it to cents at this stage loses money slowly.
  costoUnitario Decimal @db.Decimal(12, 4)

  recibidaAt DateTime @default(now())
  createdAt  DateTime @default(now())

  movimientos inventario_movimiento[]

  /// The FIFO order itself. `recibidaAt` first, `createdAt` as the tie-break so two layers
  /// received in the same instant still consume deterministically.
  @@index([productoId, recibidaAt, createdAt])
  @@map("inventario_capa")
}

/// The stock ledger. Append-only in spirit: existencia is the sum of this, never edited directly.
///
/// A single issue of 15 units spanning three layers writes THREE rows, one per layer, each with
/// the cost that layer actually charged. That is what makes cost of sale reconstructible.
model inventario_movimiento {
  id         String   @id
  productoId String
  producto   producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  /// entrada | salida | ajuste
  tipo String @db.VarChar(16)
  /// Always POSITIVE. `tipo` carries the direction — a signed quantity plus a type is two sources
  /// of truth for the same fact, and they drift.
  cantidad Decimal @db.Decimal(12, 3)
  /// Cost this movement moved, at the layer's unit cost.
  costoUnitario Decimal @db.Decimal(12, 4)
  costoTotal    Decimal @db.Decimal(12, 2)

  capaId    String?
  capa      inventario_capa?    @relation(fields: [capaId], references: [id], onDelete: SetNull)
  entradaId String?
  entrada   inventario_entrada? @relation(fields: [entradaId], references: [id], onDelete: SetNull)

  /// What it was for. A part issued to a job points at both.
  notaId    String?
  nota      nota_servicio? @relation(fields: [notaId], references: [id], onDelete: SetNull)
  conceptoId String?
  concepto   cotizacion_concepto? @relation(fields: [conceptoId], references: [id], onDelete: SetNull)

  /// Mandatory on an `ajuste` — enforced by `inventario_ajuste_motivo_check`. An adjustment with
  /// no reason is shrinkage nobody will ever explain.
  motivo String? @db.VarChar(255)

  registradoPorId String?
  registradoPor   user?    @relation("movimientoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([productoId, createdAt])
  @@index([notaId])
  @@index([tipo])
  @@map("inventario_movimiento")
}

/// A mechanic asking for a part.
///
/// Deliberately NOT an inventory movement: asking is not taking. Somebody at the counter fills it
/// (which is what writes the salida) or turns it down, and the request is the record of the gap
/// between what the job needed and what the shop had.
model solicitud_refaccion {
  id     String        @id
  notaId String
  nota   nota_servicio @relation(fields: [notaId], references: [id], onDelete: Cascade)

  /// Free text, because a mechanic knows what they need before it has a SKU.
  descripcion String  @db.VarChar(500)
  productoId  String?
  producto    producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  cantidad    Decimal   @db.Decimal(12, 3)

  /// pendiente | surtida | rechazada
  estado String @default("pendiente") @db.VarChar(16)
  /// Mandatory on a rejection — it is what the mechanic reads to know what to do instead.
  resolucionMotivo String? @db.VarChar(500)

  solicitadaPorId String?
  solicitadaPor   user?   @relation("refaccionSolicitadaPor", fields: [solicitadaPorId], references: [id], onDelete: SetNull)
  resueltaPorId   String?
  resueltaPor     user?   @relation("refaccionResueltaPor", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  resueltaAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notaId])
  @@index([estado])
  @@map("solicitud_refaccion")
}
