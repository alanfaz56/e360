{
	"name": "estacion360",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"test": "tsx scripts/check-roles.ts && tsx scripts/check-errores.ts && tsx scripts/check-facturacion.ts && tsx scripts/check-sat.ts && tsx scripts/check-agenda.ts && tsx scripts/check-comercial.ts && tsx scripts/check-r2.ts && tsx scripts/check-notas.ts && tsx scripts/check-push.ts && tsx scripts/check-inventario.ts && tsx scripts/check-correo.ts && tsx scripts/check-dashboard.ts && tsx scripts/check-talleres.ts",
		"vapid": "tsx scripts/gen-vapid.ts",
		"llave": "tsx scripts/gen-llave.ts",
		"telegram:webhook": "tsx --tsconfig scripts/tsconfig.json scripts/telegram-set-webhook.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/pg": "^8.20.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prisma": "^7.7.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.120.0",
		"@google/genai": "^2.18.0",
		"@lucide/svelte": "^1.28.0",
		"@opentelemetry/api": "^1.9.1",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"better-auth": "^1.6.1",
		"dotenv": "^17.4.1",
		"intl-tel-input": "^29.2.2",
		"openai": "^7.5.0",
		"pg": "^8.20.0",
		"posthog-js": "^1.425.1",
		"posthog-node": "^5.51.6"
	}
}
