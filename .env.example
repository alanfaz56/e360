# PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# Secret used to sign auth tokens and cookies. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-string"

# Public origin of the app. Invitation links and auth callbacks are built from it.
BETTER_AUTH_URL="http://localhost:5173"

# Optional. Password for the seeded admin (alan@maieutica.mx).
# Leave unset and `npx prisma db seed` generates one and prints it once.
SEED_ADMIN_PASSWORD=""

# Optional. Password shared by the three demo accounts the seed creates, one per role:
# gerente@ / operador@ / taller@estacion360.test  (.test never resolves, so they cannot
# receive real mail). Falls back to SEED_ADMIN_PASSWORD, then to a generated one.
SEED_DEMO_PASSWORD=""

# Cloudflare Turnstile — the gate on the public appointment form at /citas.
# These are Cloudflare's documented ALWAYS-PASS test keys, so local development exercises the
# real verification code path instead of a bypass flag. Replace both with the real site's keys
# before deploying: an unset secret makes /citas answer 503, never an open door.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Cloudflare R2 — evidence (intake photos, documents) on the notas de servicio.
# Uploads are presigned and go straight from the browser to R2, so the bucket needs CORS allowing
# PUT from the app's origin. Leave these unset and the upload endpoint answers 503: it fails
# closed rather than pretending to store anything.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STORAGEBUCKET=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
# Optional. A public bucket domain (r2.dev or custom) for reading. Without it, read URLs are
# short-lived signed GETs, so a private bucket works too — the links just expire.
STORAGE_PUBLIC_URL=""

# Web Push (VAPID) — browser notifications for staff and customers.
# Generate a pair with:  npm run vapid
# Leave these unset and push is simply OFF: the in-app notification centre keeps working and the
# UI says push is not configured, instead of a button that fails silently. This is the one
# integration that degrades rather than failing closed, because a notification is a courtesy on
# top of the inbox, not a gate on anything.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Where a push service should complain if our notifications misbehave. mailto: or https:.
VAPID_SUBJECT="mailto:soporte@estacion360.mx"

# ------------------------------------------------------------------------------------------------
# Ajustes del sistema
# ------------------------------------------------------------------------------------------------
# Who reaches /panel/ajustes: the credentials that stamp CFDIs and what stamping costs.
#
# `ajustes:read` / `ajustes:manage` are Admin in the permission registry AND narrowed by this list,
# because the two answer different questions: the registry says "an Admin may", this says "which
# Admin". The shop's own owner will be an Admin one day and that account manages the shop, not our
# PAC account.
#
# Comma-separated. **An empty list denies everybody** — a misconfigured deployment must not open
# this screen to every Admin, so there is no "unset means unrestricted".
OWNER_EMAILS="alan@maieutica.mx"

# Encrypts the credentials stored in the `ajuste` table (AES-256-GCM). Generate with `npm run llave`.
# It lives HERE and never in the database: that is what makes a database dump not a set of keys.
# Rotating it makes every stored secret unreadable — re-enter them in /panel/ajustes.
AJUSTES_SECRET_KEY=""

# ------------------------------------------------------------------------------------------------
# Facturación (PAC)
# ------------------------------------------------------------------------------------------------
# Nothing here. On purpose: the API key, the secret key, the serie and the environment are captured
# on /panel/ajustes and stored encrypted, so switching PAC accounts or rotating a credential is not
# a redeploy. The only environment variable facturación needs is AJUSTES_SECRET_KEY above.
#
# A sandbox account is NOT self-serve: factura.com hands out sandbox credentials on request, by
# email to their support. Sandbox stamps CFDIs with no fiscal validity at https://sandbox.factura.com/api.
