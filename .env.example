# PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# Secret used to sign auth tokens and cookies. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-string"

# Public origin of the app. Invitation links and auth callbacks are built from it.
BETTER_AUTH_URL="http://localhost:5173"

# Optional. Password for the seeded admin (alan@maieutica.mx).
# Leave unset and `npx prisma db seed` generates one and prints it once.
SEED_ADMIN_PASSWORD=""

# Optional. Password shared by the three demo accounts the seed creates, one per role:
# gerente@ / operador@ / taller@estacion360.test  (.test never resolves, so they cannot
# receive real mail). Falls back to SEED_ADMIN_PASSWORD, then to a generated one.
SEED_DEMO_PASSWORD=""

# Cloudflare Turnstile — the gate on the public appointment form at /citas.
# These are Cloudflare's documented ALWAYS-PASS test keys, so local development exercises the
# real verification code path instead of a bypass flag. Replace both with the real site's keys
# before deploying: an unset secret makes /citas answer 503, never an open door.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
